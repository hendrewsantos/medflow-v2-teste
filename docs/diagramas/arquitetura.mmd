  INF["<b>MedFlow.Infrastructure</b><br/>EF Core + Pomelo · PBKDF2 · JWT · armazenamento de receitas"]
  DB[("MySQL 8")]
  FS[("Pasta privada de arquivos")]
  SPA -- "HTTPS · JSON · Authorization: Bearer" --> API
  API -- "chama" --> APP
  APP -- "usa as regras" --> DOM
  INF -- "implementa os contratos" --> APP
  API -. "registra na injeção de dependência" .-> INF
  INF --> DB
  INF --> FS
